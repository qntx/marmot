{
  "expo": {
    "name": "MarmotSmoke",
    "slug": "native-smoke",
    "version": "0.0.0",
    "scheme": "marmotsmoke",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "bundleIdentifier": "xyz.qntx.marmotsmoke",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "xyz.qntx.marmotsmoke"
    },
    "plugins": [
      "./plugins/withLocalhostCleartext.js",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "expo-dev-client"
    ]
  }
}
